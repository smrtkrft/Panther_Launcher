<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <!-- Nothing goes to the cloud backup: settings contain notes, hidden and locked apps and a saved location -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>

    <!-- Moving directly to a new device keeps settings and the widget layout -->
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>

</data-extraction-rules>
