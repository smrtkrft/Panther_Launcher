<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: nothing is copied to the cloud backup. Settings contain notes, hidden and
     locked apps and a saved location; they are moved with "Backup and restore" in the launcher. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
